# Public backend API URL, including /api/v1. Keep backend secrets out of NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# NextAuth session and OIDC provider configuration (server-side only).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret
OIDC_ISSUER_URL=https://your-identity-provider.example/auth/v1
OIDC_CLIENT_ID=authenticated
OIDC_CLIENT_SECRET=

# Enable only for local backend DEBUG mode. Dev sign-in is hidden in production.
DEV_MODE=true
BACKEND_URL=http://localhost:8000
