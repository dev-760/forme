# =============================================================================
# Wardrowbe Backend — Python 3.14 + PostgreSQL 18 (Vercel + Supabase + OpenRouter)
# =============================================================================

# --- Application & Security ---
APP_NAME=Wardrowbe
# Set to your frontend URL (used for CORS, OIDC redirects, and OpenRouter HTTP-Referer)
APP_URL=https://your-frontend.vercel.app
CORS_ORIGINS=["https://your-frontend.vercel.app","http://localhost:3000"]
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-chars
DEBUG=false
ENABLE_DOCS=false
SERVERLESS_MODE=true

# --- Authentication (Supabase Auth OIDC, Forward Auth, or DEBUG=true for dev) ---
OIDC_ISSUER_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1
OIDC_CLIENT_ID=authenticated
OIDC_CLIENT_SECRET=
FORWARD_AUTH_SECRET=

# --- PostgreSQL 18 / Supabase PostgreSQL ---
# Transaction pooler (port 6543), Session pooler (port 5432), or direct PostgreSQL 18 URL:
# postgres://, postgresql://, ?pgbouncer=true, ?channel_binding=require, and PG 18 ?sslnegotiation=direct are supported.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Supabase Storage & Auth Keys ---
STORAGE_BACKEND=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=wardrobe

# --- Serverless Job Queue & Redis (Optional on Vercel) ---
# 'inline' runs AI tagging, rotation, and HTTP background removal via FastAPI BackgroundTasks
JOB_QUEUE_MODE=inline
REDIS_URL=none

# --- OpenRouter AI (Parallel Multi-Model Outfit Generation + Vision Tagging) ---
AI_INTERNAL_ENABLED=true
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-your-openrouter-api-key
AI_VISION_MODEL=google/gemma-4-31b-it:free,thinkingmachines/inkling:free
AI_TEXT_MODEL=google/gemma-4-31b-it:free,thinkingmachines/inkling:free
AI_PARALLEL_OUTFIT_GENERATION=true
AI_HTTP_REFERER=
AI_APP_TITLE=Wardrowbe
AI_TIMEOUT=50
AI_MAX_RETRIES=2
AI_MAX_TOKENS=8000
AI_REASONING_EFFORT=none

# --- ClearBackdrop / HTTP Background Removal (rembg is omitted on Vercel to stay <250MB) ---
BG_REMOVAL_PROVIDER=http
BG_REMOVAL_URL=https://clearbackdrop.com/api/v1/remove-background
BG_REMOVAL_API_KEY=cbk_your_clearbackdrop_api_key
